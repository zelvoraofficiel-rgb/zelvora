    "zod": "3.24.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "prisma": "6.6.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
