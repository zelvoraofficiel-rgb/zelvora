# Required in production: a randomly generated secret of at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL target for the production Prisma adapter. Example:
# DATABASE_URL="postgresql://zelvora:password@localhost:5432/zelvora?schema=public"
DATABASE_URL=

# AI provider adapter. Keep DEMO until an approved provider is configured.
AI_PROVIDER=demo
# AI_API_KEY=

# Object storage adapter (S3-compatible; required for production uploads)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Google OAuth (not activated until all values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application URL used for public store URLs and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase client configuration. The publishable key may be exposed to the browser;
# all access must still be governed by RLS. Never put a service_role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# local while testing the local adapter; switch only after running supabase/migrations/0001_zelvora_core.sql
ZELVORA_DATA_PROVIDER=local
